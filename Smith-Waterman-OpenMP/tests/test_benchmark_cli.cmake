set(ENV{OMP_DYNAMIC} "FALSE")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef suffix)
set(output_dir "${WORK_DIR}/benchmark-smoke-${suffix}")
set(count 0)
function(invalid label pattern)
    execute_process(COMMAND "${BENCH_EXECUTABLE}" ${ARGN}
        RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT "${code}" STREQUAL "1" OR NOT "${error}" MATCHES "${pattern}")
        message(FATAL_ERROR "${label}: code=${code}, output=${output}, error=${error}")
    endif()
    message(STATUS "PASS ${label}")
endfunction()
execute_process(COMMAND "${BENCH_EXECUTABLE}" --help RESULT_VARIABLE code OUTPUT_VARIABLE help)
if(NOT "${code}" STREQUAL "0" OR NOT "${help}" MATCHES "warmup")
    message(FATAL_ERROR "Benchmark help failed.")
endif()
message(STATUS "PASS help")
execute_process(COMMAND "${BENCH_EXECUTABLE}" --suite smoke --threads 1 --warmup 2 --runs 7
    --allow-debug --output "${output_dir}" RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT "${code}" STREQUAL "0" OR NOT "${error}" STREQUAL "")
    message(FATAL_ERROR "Smoke benchmark failed: ${code}\n${output}\n${error}")
endif()
file(STRINGS "${output_dir}/raw_benchmark.csv" raw)
file(STRINGS "${output_dir}/summary_benchmark.csv" summary)
list(LENGTH raw raw_count)
list(LENGTH summary summary_count)
if(NOT raw_count EQUAL 55 OR NOT summary_count EQUAL 7)
    message(FATAL_ERROR "Unexpected CSV row counts: raw=${raw_count}, summary=${summary_count}")
endif()
file(READ "${output_dir}/run_metadata.json" metadata)
if(NOT "${metadata}" MATCHES "\"status\": \"complete\"")
    message(FATAL_ERROR "Metadata did not mark run complete.")
endif()
message(STATUS "PASS verified_smoke_CSV_and_metadata")
file(SHA256 "${output_dir}/raw_benchmark.csv" before)
invalid(no_overwrite "Output directory must be new" --allow-debug --output "${output_dir}")
file(SHA256 "${output_dir}/raw_benchmark.csv" after)
if(NOT before STREQUAL after)
    message(FATAL_ERROR "Old results overwritten.")
endif()
invalid(too_few_warmups "Invalid integer" --allow-debug --output "${output_dir}-invalid" --warmup 1)
invalid(too_few_runs "Invalid integer" --allow-debug --output "${output_dir}-invalid" --runs 6)
invalid(duplicate_threads "Duplicate benchmark" --allow-debug --output "${output_dir}-invalid" --threads 1,1)
invalid(bad_threads "Invalid integer" --allow-debug --output "${output_dir}-invalid" --threads 0)
invalid(bad_schedule "Unknown schedule" --allow-debug --output "${output_dir}-invalid" --schedules other)
invalid(missing_output "Missing required option" --allow-debug --suite smoke)
invalid(mixed_inputs "Cannot combine" --allow-debug --output "${output_dir}-invalid" --suite smoke --query file)
set(external_dir "${output_dir}-external")
execute_process(COMMAND "${BENCH_EXECUTABLE}" --allow-debug --query "${SAMPLE_DIR}/queries.fasta"
    --query-id query_2 --references "${SAMPLE_DIR}/references.fasta" --threads 1 --schedules static
    --output "${external_dir}" RESULT_VARIABLE code ERROR_VARIABLE error)
if(NOT "${code}" STREQUAL "0")
    message(FATAL_ERROR "External FASTA benchmark failed: ${error}")
endif()
message(STATUS "PASS external_FASTA")
if("${metadata}" MATCHES "\"build_type\": \"Release\"")
    execute_process(COMMAND "${BENCH_EXECUTABLE}" --suite smoke --threads 1 --output "${output_dir}-release-policy"
        RESULT_VARIABLE code ERROR_VARIABLE error)
    if(NOT "${code}" STREQUAL "0")
        message(FATAL_ERROR "Release build should run without --allow-debug: ${error}")
    endif()
    message(STATUS "PASS release_build_policy")
else()
    invalid(debug_build_guard "requires Release" --suite smoke --threads 1 --output "${output_dir}-debug-policy")
endif()
message(STATUS "Passed: 12 benchmark CLI cases")
